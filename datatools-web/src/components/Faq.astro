---
interface Props { items: { pregunta: string; respuesta: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details>
      <summary>{f.pregunta}</summary>
      <p>{f.respuesta}</p>
    </details>
  ))}
</div>
<script type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((f) => ({ '@type': 'Question', name: f.pregunta, acceptedAnswer: { '@type': 'Answer', text: f.respuesta } })),
})} />
