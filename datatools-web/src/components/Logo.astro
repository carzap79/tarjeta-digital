---
/**
 * Marca gráfica oficial de Data Tools (tomada de www.datatools.com.co).
 *  - variante "marca": globo + rótulo DATA TOOLS sobre fondo transparente (cabecera, fondos claros).
 *  - variante "sello": disco blanco con la marca, tal como se usa en el sitio oficial (pie, fondos oscuros).
 * Archivos: public/logo-datatools.svg (95×98) y public/logo-datatools-sello.svg (141×141): SVG que envuelven el PNG oficial.
 * Cuando exista el logo en vector real, basta con reemplazar esos dos archivos sin tocar el resto.
 */
interface Props { variante?: 'marca' | 'sello'; alto?: number; claro?: boolean }
const { variante = 'marca', alto = 52 } = Astro.props;
const archivo = variante === 'sello' ? '/logo-datatools-sello.svg' : '/logo-datatools.svg';
const proporcion = variante === 'sello' ? 1 : 95 / 98;
const ancho = Math.round(alto * proporcion);
---
<img class="logo" src={archivo} alt="Data Tools S.A.S" width={ancho} height={alto} decoding="async" />

<style>
  .logo { display: block; height: auto; }
</style>
